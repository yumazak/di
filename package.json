{
  "name": "di",
  "version": "0.2.1",
  "private": true,
  "description": "ローカルの git 差分をブラウザで見る CLI（Go バックエンド + React フロント）",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm run --parallel \"/^dev:/\"",
    "dev:api": "go run . . --port 7777 --no-open",
    "dev:web": "vite",
    "build": "vite build && node scripts/pack-web.mjs && go build -ldflags=\"-s -w\" -o dist/di .",
    "release": "./scripts/release.sh",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "vet": "go vet ./..."
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@pierre/diffs": "1.3.5",
    "@pierre/icons": "0.7.1",
    "@pierre/theming": "1.0.1",
    "@pierre/trees": "1.0.0-beta.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  },
  "engines": {
    "node": ">=20.19"
  }
}
